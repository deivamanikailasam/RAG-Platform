[project]
name = "{{ slug }}"
version = "0.1.0"
description = "{{ purpose }}"
requires-python = ">=3.12,<3.13"
dependencies = [
    # The platform's engine. 1.x keeps its contracts and component names (semantic versioning).
    "rag-core[postgres,valkey,pdf,docx]>={{ platform_version }},<2",
]

[dependency-groups]
dev = ["pytest", "ruff"]

# This project's own components (parsers, enrichers, guards, …): registered on import.
[project.entry-points."rag_core.components"]
{{ module }} = "{{ module }}.components"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ module }}"]

# The platform's style (Step 5): `just lint` runs ruff check and ruff format --check
[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "SIM", "RUF"]
ignore = ["E501"]   # line length is the formatter's job

[tool.ruff.lint.isort]
known-first-party = ["{{ module }}"]   # rag-core is a dependency (third party) here

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
