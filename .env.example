# The settings this platform expects. NO real values here; real secrets live in
# secrets/dev.enc.env (encrypted) or the macOS Keychain (personal tokens).
POSTGRES_PASSWORD=<generated>                         # rag-db superuser (Step 11): admin only
RAG_DB_MIGRATOR_PASSWORD=<generated: letters/digits only>   # rag_migrator: dbmate migrations
RAG_DB_APP_PASSWORD=<generated: letters/digits only>        # rag_app: services (rows only)
RAG_DB_READONLY_PASSWORD=<generated: letters/digits only>   # rag_readonly: evals, analytics
QDRANT_API_KEY=<64 hex characters, from: openssl rand -hex 32>            # Qdrant admin (Step 12): also signs JWTs
QDRANT_READ_ONLY_API_KEY=<64 hex characters, from: openssl rand -hex 32>  # Qdrant read-only key, for quick checks
OPENSEARCH_ADMIN_PASSWORD=<strong: upper+lower+digit+symbol, e.g. $(openssl rand -base64 24 | tr -d '/+=\n')#9Qx>  # OpenSearch admin (Step 13): setup only
OPENSEARCH_SEARCH_PASSWORD=<strong, as above>     # rag_search: read-only on rag-chunks*
OPENSEARCH_INDEXER_PASSWORD=<strong, as above>    # rag_indexer: writes rag-chunks*
S3_ADMIN_ACCESS_KEY=<20 upper-case letters/digits>   # object store "admin" (Step 14): bucket setup only
S3_ADMIN_SECRET_KEY=<40 letters/digits>
S3_INGEST_ACCESS_KEY=<20 upper-case letters/digits>  # rag-ingest: read/write rag-raw-docs and rag-tmp
S3_INGEST_SECRET_KEY=<40 letters/digits>
S3_READER_ACCESS_KEY=<20 upper-case letters/digits>  # rag-reader: read rag-raw-docs only
S3_READER_SECRET_KEY=<40 letters/digits>
VALKEY_ADMIN_PASSWORD=<generated: letters/digits only>     # Valkey "admin" (Step 15): all keys and commands, admin tasks only
VALKEY_LITELLM_PASSWORD=<generated: letters/digits only>   # litellm: the gateway's response cache (no @dangerous)
VALKEY_APP_PASSWORD=<generated: letters/digits only>       # rag_app: rag:* keys only (no @dangerous/@admin)
KEYCLOAK_ADMIN_PASSWORD=<generated>
LITELLM_MASTER_KEY=sk-<generated>
LITELLM_DB_PASSWORD=<generated: letters/digits only, safe inside a URL>
LITELLM_SALT_KEY=<64 hex characters, from: openssl rand -hex 32; never change it>
TEI_API_KEY=<48 hex characters, from: openssl rand -hex 24>
GRAFANA_ADMIN_PASSWORD=<generated>
LANGFUSE_SALT=<generated>
LANGFUSE_NEXTAUTH_SECRET=<generated>
LANGFUSE_ENCRYPTION_KEY=<64 hex characters>
DEMO_TOKEN=<generated>
HF_TOKEN=<from macOS Keychain>

# --- Gateway (Step 9): the ONLY way applications reach models ---
LLM_GATEWAY_URL=http://127.0.0.1:4000                # from containers: http://litellm:4000
LLM_GATEWAY_KEY=<virtual key from Step 10; master key only for admin tasks>

# --- Per-app virtual keys (Step 10): created with `just gateway-admin key ...`, shown ONCE ---
RAG_API_GATEWAY_KEY=sk-<virtual key for rag-api-dev>
INGESTION_GATEWAY_KEY=sk-<virtual key for ingestion-dev>
EVAL_GATEWAY_KEY=sk-<virtual key for eval-harness>
