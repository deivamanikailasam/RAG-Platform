# The settings this platform expects. NO real values here; real secrets live in
# secrets/dev.enc.env (encrypted) or the macOS Keychain (personal tokens).
POSTGRES_PASSWORD=<generated>                         # rag-db superuser (Step 11): admin only
RAG_DB_MIGRATOR_PASSWORD=<generated: letters/digits only>   # rag_migrator: dbmate migrations
RAG_DB_APP_PASSWORD=<generated: letters/digits only>        # rag_app: services (rows only)
RAG_DB_READONLY_PASSWORD=<generated: letters/digits only>   # rag_readonly: evals, analytics
QDRANT_API_KEY=<64 hex characters, from: openssl rand -hex 32>            # Qdrant admin (Step 12): also signs JWTs
QDRANT_READ_ONLY_API_KEY=<64 hex characters, from: openssl rand -hex 32>  # Qdrant read-only key, for quick checks
OPENSEARCH_ADMIN_PASSWORD=<strong: upper+lower+digit+symbol, e.g. $(openssl rand -base64 24 | tr -d '/+=\n')#9Qx>  # OpenSearch admin (Step 13): setup only
OPENSEARCH_SEARCH_PASSWORD=<strong, as above>     # rag_search: read-only on rag-chunks*
OPENSEARCH_INDEXER_PASSWORD=<strong, as above>    # rag_indexer: writes rag-chunks*
S3_ADMIN_ACCESS_KEY=<20 upper-case letters/digits>   # object store "admin" (Step 14): bucket setup only
S3_ADMIN_SECRET_KEY=<40 letters/digits>
S3_INGEST_ACCESS_KEY=<20 upper-case letters/digits>  # rag-ingest: read/write rag-raw-docs and rag-tmp
S3_INGEST_SECRET_KEY=<40 letters/digits>
S3_READER_ACCESS_KEY=<20 upper-case letters/digits>  # rag-reader: read rag-raw-docs only
S3_READER_SECRET_KEY=<40 letters/digits>
VALKEY_ADMIN_PASSWORD=<generated: letters/digits only>     # Valkey "admin" (Step 15): all keys and commands, admin tasks only
VALKEY_LITELLM_PASSWORD=<generated: letters/digits only>   # litellm: the gateway's response cache (no @dangerous)
VALKEY_APP_PASSWORD=<generated: letters/digits only>       # rag_app: rag:* keys only (no @dangerous/@admin)
KEYCLOAK_ADMIN_PASSWORD=<generated>                  # Keycloak temp-admin (Step 6/16): first start only
KEYCLOAK_DB_PASSWORD=<generated: letters/digits only>        # keycloak-db (Step 16)
KEYCLOAK_PROVISIONER_SECRET=<generated: letters/digits only> # rag-provisioner client secret: manages users only
KEYCLOAK_INGESTION_SECRET=<generated: letters/digits only>   # ingestion-worker client secret (client credentials)
OPA_API_TOKEN=<40 letters/digits, from: openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-40>  # rag-api -> OPA decisions (Step 18)
LITELLM_MASTER_KEY=sk-<generated>
LITELLM_DB_PASSWORD=<generated: letters/digits only, safe inside a URL>
LITELLM_SALT_KEY=<64 hex characters, from: openssl rand -hex 32; never change it>
TEI_API_KEY=<48 hex characters, from: openssl rand -hex 24>
GRAFANA_ADMIN_PASSWORD=<generated>                   # Grafana "admin" (Step 20): the only monitoring UI with a login
OPA_METRICS_TOKEN=<32 letters/digits, from: openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-32>  # Prometheus -> OPA /metrics only (Step 20)
RAG_DB_METRICS_PASSWORD=<32 letters/digits, as above>  # rag_metrics (pg_monitor): postgres_exporter (Step 20)
LANGFUSE_SALT=<32 letters/digits; never change it>       # Langfuse (Step 22): hashes API keys
LANGFUSE_NEXTAUTH_SECRET=<32 letters/digits>             # Langfuse: signs login sessions
LANGFUSE_ENCRYPTION_KEY=<64 hex characters, from: openssl rand -hex 32; never change it>  # encrypts stored credentials
LANGFUSE_DB_PASSWORD=<32 letters/digits, safe inside a URL>   # langfuse-db
LANGFUSE_CLICKHOUSE_PASSWORD=<32 letters/digits>         # langfuse-clickhouse, user "langfuse"
LANGFUSE_VALKEY_PASSWORD=<32 letters/digits>             # langfuse-valkey (its own instance, noeviction)
LANGFUSE_ADMIN_PASSWORD=<32 letters/digits>              # admin@example.com, created by headless init
S3_LANGFUSE_ACCESS_KEY=<20 upper-case letters/digits>    # langfuse: bucket "langfuse" only
S3_LANGFUSE_SECRET_KEY=<40 letters/digits>
LANGFUSE_PUBLIC_KEY=pk-lf-<uuid, from: uuidgen | tr A-Z a-z>   # identifies the project (not secret)
LANGFUSE_SECRET_KEY=sk-lf-<uuid, from: uuidgen | tr A-Z a-z>   # authorises writes: rag-api reads it as a secret file
AUDIT_DB_MIGRATOR_PASSWORD=<32 letters/digits, safe inside a URL>   # audit_migrator (Step 23): owns the audit schema, runs its migrations
AUDIT_DB_WRITER_PASSWORD=<32 letters/digits>              # audit_writer: rag-api, may ONLY call audit.append()
AUDIT_DB_READER_PASSWORD=<32 letters/digits>              # audit_reader: anchor/verify jobs and auditors, read only
S3_AUDIT_ANCHOR_ACCESS_KEY=<32 letters/digits>            # audit-anchor: read/write/list rag-audit-archive
S3_AUDIT_ANCHOR_SECRET_KEY=<32 letters/digits>
S3_AUDIT_READER_ACCESS_KEY=<32 letters/digits>            # audit-reader: read/list rag-audit-archive only
S3_AUDIT_READER_SECRET_KEY=<32 letters/digits>
VAULT_ADMIN_PG_PASSWORD=<32 letters/digits>               # Step 28: bootstrap for OpenBao's database logins; rotated away by `just vault-setup`
BAO_ADMIN_PASSWORD=<32 letters/digits>                    # Step 28: your OpenBao "admin" userpass login (just vault-login)
DEMO_TOKEN=<generated>
HF_TOKEN=<from macOS Keychain>

# --- Gateway (Step 9): the ONLY way applications reach models ---
LLM_GATEWAY_URL=http://127.0.0.1:4000                # from containers: http://litellm:4000
LLM_GATEWAY_KEY=<virtual key from Step 10; master key only for admin tasks>

# --- Per-app virtual keys (Step 10): created with `just gateway-admin key ...`, shown ONCE ---
RAG_API_GATEWAY_KEY=sk-<virtual key for rag-api-dev>
INGESTION_GATEWAY_KEY=sk-<virtual key for ingestion-dev>
EVAL_GATEWAY_KEY=sk-<virtual key for eval-harness>

# --- Kubernetes and Argo CD (Step 29): the only two Kubernetes Secrets, added by hand with `sops secrets/dev.enc.env` ---
GHCR_USER=<your GitHub user name>                    # just k8s-pull-secret: lets the cluster pull your private images
GHCR_READ_TOKEN=<fine-grained PAT: packages read-only, with an expiry date>
ARGOCD_DEPLOY_KEY=<ed25519 private key; its .pub is a read-only deploy key on the repo>   # just k8s-repo-secret
