# Reference copy of ~/.ssh/config (Step 4): log in to GitHub with the ed25519 key.
# Copy during workstation setup (append if you already have a ~/.ssh/config):
#   mkdir -p ~/.ssh && chmod 700 ~/.ssh
#   cat bootstrap/home/.ssh/config >> ~/.ssh/config && chmod 600 ~/.ssh/config
Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
