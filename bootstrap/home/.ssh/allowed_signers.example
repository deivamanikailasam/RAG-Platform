# Example of ~/.ssh/allowed_signers (Step 4): the public keys git trusts when verifying
# SSH commit signatures locally (git log --show-signature). One line per signer:
#   <email> namespaces="git" <public key from ~/.ssh/id_ed25519.pub>
# Generate the real file on your Mac with (never commit it with someone else's keys by mistake):
#   echo "$(git config --global user.email) namespaces=\"git\" $(cat ~/.ssh/id_ed25519.pub)" >> ~/.ssh/allowed_signers
you@example.com namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE you@example.com
